# AporiaRAG settings. Copy to `.env` and uncomment what you want to change;
# every value below is the default. Real environment variables override `.env`.
# Format: APORIA_<SECTION>__<FIELD> (two underscores between section and field).

# --- Ollama server ---------------------------------------------------------
# APORIA_OLLAMA__HOST=http://localhost:11434
# APORIA_OLLAMA__TIMEOUT_SECONDS=120
# How long Ollama keeps a model loaded after a request ("10m", "1h", "-1" = forever).
# APORIA_OLLAMA__KEEP_ALIVE=10m

# --- Embedding model -------------------------------------------------------
# Changing the provider, model, dimensions or query instruction creates a new,
# separate index: run `aporia-rag index` afterwards.
# APORIA_EMBEDDING__PROVIDER=ollama
# Supported model families: qwen3-embedding, embeddinggemma, nomic-embed-text.
# APORIA_EMBEDDING__MODEL=qwen3-embedding:0.6b
# Shorter vectors for models trained for it (Matryoshka); empty = the model's own size.
# APORIA_EMBEDDING__DIMENSIONS=
# APORIA_EMBEDDING__BATCH_SIZE=32
# Replace the model's default query instruction (Qwen3) or task (EmbeddingGemma).
# APORIA_EMBEDDING__QUERY_INSTRUCTION=

# --- Chat model ------------------------------------------------------------
# APORIA_CHAT__PROVIDER=ollama
# 22 GB, needs 32 GB of RAM. With 16 GB, use qwen3.5:9b-q4_K_M (6.6 GB).
# APORIA_CHAT__MODEL=qwen3.5:35b-a3b-q4_K_M
# Tokens the model sees at once, prompt and reply; `ask --all-authors` needs ~4,500.
# APORIA_CHAT__CONTEXT_LENGTH=8192

# --- Chunking (characters) -------------------------------------------------
# APORIA_CHUNKING__SIZE=1000
# APORIA_CHUNKING__OVERLAP=150

# --- Storage ---------------------------------------------------------------
# APORIA_STORAGE__PROVIDER=chroma
# APORIA_STORAGE__CORPUS_DIR=data/raw
# APORIA_STORAGE__INDEX_DIR=data/index

# --- Web search --------------------------------------------------------------
# Searched only for a question the corpus cannot answer; the question is then
# sent to search engines (ddgs: Wikipedia, Brave, DuckDuckGo, Google...).
# APORIA_WEB__PROVIDER=ddgs
